{
  "name": "boutica-desktop",
  "productName": "Boutica Desktop",
  "version": "0.1.0",
  "description": "Client Desktop (Electron) de Boutica Cloud — gestion commerciale",
  "author": "Fluo",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node scripts/dev.mjs",
    "dev:renderer": "vite --port=3000",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "clean": "rm -rf dist dist-electron out",
    "test": "node --test src/renderer/lib/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^38.0.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.3.0"
  }
}
